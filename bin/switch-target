#!/usr/bin/env bash
# bin/switch-target — flip already-provisioned recorder Pis between processing targets
# (Mac <-> GPU box) WITHOUT a full re-provision (no install_pi.sh, no reboot, ~5 s/Pi).
#
#   ./bin/switch-target --target gpu aq@10.0.0.11 aq@10.0.0.12   # both arms -> the box
#   ./bin/switch-target --target mac aq@10.0.0.11 aq@10.0.0.12   # back to the Mac
#   ./bin/switch-target --target gpu --rig myrig aq@10.0.0.11    # explicit rig env
#
# Reads the same inventory as bin/provision-pi (provisioning/rigs/<rig>.env + secrets):
#   mac              -> upload http://localhost:8091/upload via a Pi->MAC_HOST ssh tunnel
#   gpu + SERVER_SSH -> upload http://localhost:8080/upload via a Pi->box ssh tunnel
#                       (cloud box with only :22 open)
#   gpu + SERVER_URL -> direct upload (LAN box; tunnel disabled)
# Per Pi it rewrites ROBOT_UMI_SERVER_URL in ~/robot-umi/.env, renders/enables (or
# disables) umi-upload-tunnel.service, restarts umi-recorder, and verifies the target
# answers through the tunnel. Requires the Pi's ssh key to already be trusted on the
# tunnel endpoint — bin/provision-pi sets that up; this script only checks it.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"  # repo root (script lives in bin/)
die() { echo "switch_target: $*" >&2; exit 1; }

TARGET=""; RIG=""; PIS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2:?}"; shift 2;;
    --rig) RIG="${2:?}"; shift 2;;
    -h|--help) sed -n '2,17p' "$0"; exit 0;;
    -*) die "unknown flag $1";;
    *) PIS+=("$1"); shift;;
  esac
done
[ -n "$TARGET" ] && [ "${#PIS[@]}" -gt 0 ] || die "usage: ./bin/switch-target --target mac|gpu [--rig <name>] <user@pi> [...]"

SECRETS="$HERE/provisioning/secrets"
[ -f "$SECRETS" ] && . "$SECRETS" || true

for PI in "${PIS[@]}"; do
  PI_USER="${PI%@*}"; PI_HOST="${PI#*@}"
  R="${RIG:-$PI_HOST}"
  RIGFILE="$HERE/provisioning/rigs/$R.env"
  [ -f "$RIGFILE" ] || die "missing $RIGFILE (rig inventory for $PI)"
  # subshell so one rig's vars don't leak into the next Pi's resolution
  (
    . "$RIGFILE"
    TUNNEL=0; TUN_LOCAL=""; TUN_REMOTE=""; TUN_SSH=""
    case "$TARGET" in
      mac)
        [ -n "${MAC_HOST:-}" ] || die "target=mac needs MAC_HOST in $RIGFILE"
        URL="http://localhost:8091/upload"; TUNNEL=1; TUN_LOCAL=8091; TUN_REMOTE=8091; TUN_SSH="$MAC_HOST";;
      gpu|lambda)
        if [ -n "${SERVER_SSH:-}" ]; then
          URL="http://localhost:8080/upload"; TUNNEL=1; TUN_LOCAL=8080; TUN_REMOTE=8080; TUN_SSH="$SERVER_SSH"
        else
          [ -n "${SERVER_URL:-}" ] || die "target=gpu needs SERVER_SSH (cloud box) or SERVER_URL (LAN box) in $RIGFILE"
          URL="$SERVER_URL"
        fi;;
      *) die "target must be mac|gpu (got '$TARGET')";;
    esac

    SSH=(ssh -o ConnectTimeout=10 -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$PI")
    echo "=== $PI -> target=$TARGET url=$URL$([ "$TUNNEL" = 1 ] && echo " (tunnel via $TUN_SSH)")"

    # sudo runner: passwordless if available, else PI_PASSWORD from provisioning/secrets
    if "${SSH[@]}" 'sudo -n true' 2>/dev/null; then
      rsudo() { "${SSH[@]}" "sudo bash -c '$*'"; }
    else
      [ -n "${PI_PASSWORD:-}" ] || die "$PI needs a sudo password; set PI_PASSWORD in provisioning/secrets"
      rsudo() { printf '%s\n' "$PI_PASSWORD" | "${SSH[@]}" "sudo -S -p '' bash -c '$*'"; }
    fi

    "${SSH[@]}" "sed -i 's|^ROBOT_UMI_SERVER_URL=.*|ROBOT_UMI_SERVER_URL=$URL|' ~/robot-umi/.env"

    if [ "$TUNNEL" = 1 ]; then
      "${SSH[@]}" "ssh -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new $TUN_SSH true" \
        || die "$PI cannot ssh to $TUN_SSH — run bin/provision-pi once to install key trust"
      sed -e "s#@USER@#$PI_USER#g" -e "s#@SSH_TARGET@#$TUN_SSH#g" \
          -e "s#@LOCAL_PORT@#$TUN_LOCAL#g" -e "s#@REMOTE_PORT@#$TUN_REMOTE#g" \
          "$HERE/config/systemd/umi-upload-tunnel.service" \
        | "${SSH[@]}" 'cat > /tmp/umi-upload-tunnel.service'
      rsudo "mv /tmp/umi-upload-tunnel.service /etc/systemd/system/umi-upload-tunnel.service \
             && systemctl daemon-reload && systemctl enable --now umi-upload-tunnel \
             && systemctl restart umi-upload-tunnel && systemctl restart umi-recorder"
      sleep 2
      code=$("${SSH[@]}" "curl -m 6 -s -o /dev/null -w %{http_code} http://localhost:$TUN_LOCAL/ 2>/dev/null" || echo 000)
      [ "$code" != 000 ] && echo "    OK tunnel up (endpoint HTTP $code), recorder restarted" \
        || die "$PI tunnel not forwarding (is the target's ingest running?)"
    else
      rsudo "systemctl disable --now umi-upload-tunnel 2>/dev/null; systemctl restart umi-recorder" || true
      echo "    OK direct upload, tunnel disabled, recorder restarted"
    fi
  )
done
echo
echo "switch_target: done. Spooled episodes on each Pi upload to the NEW target automatically."
