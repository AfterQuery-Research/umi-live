#!/usr/bin/env bash
# bin/provision-pi — ONE local command: take a freshly-flashed Pi (SSH key access already
# set up) to a running, boot-persistent UMI recorder you can immediately drive with the
# buttons. Run this on your Mac/laptop, not on the Pi.
#
#   cp provisioning/secrets.example provisioning/secrets     # PI_PASSWORD + UPLOAD_TOKEN
#   cp provisioning/rigs/example.env provisioning/rigs/<pi-host>.env   # target + rig params
#   ./bin/provision-pi [--target mac|gpu|url] [--rig <name>] [--dry-run] [--no-reboot] <user@pi>
#
# It drives the Pi over SSH: ephemeral passwordless-sudo bootstrap (removed at the end),
# rsync the repo, render+push config/umi.yaml + .env, mount the SSD (fstab, nofail), run
# install_pi.sh, wire the upload target, then reboot + verify. Idempotent; re-runnable.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"  # repo root (script lives in bin/)
die() { echo "provision: $*" >&2; exit 1; }
log() { echo; echo "=== $* ==="; }

# --- args --------------------------------------------------------------------
RIG=""; PI=""; DRYRUN=0; REBOOT=1; TARGET_OVERRIDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --rig) RIG="${2:?--rig needs a name}"; shift 2;;
    --target) TARGET_OVERRIDE="${2:?--target needs mac|gpu|url}"; shift 2;;
    --dry-run) DRYRUN=1; shift;;
    --no-reboot) REBOOT=0; shift;;
    -h|--help) sed -n '2,14p' "$0"; exit 0;;
    -*) die "unknown flag $1";;
    *) [ -z "$PI" ] || die "unexpected extra argument '$1'"; PI="$1"; shift;;
  esac
done
[ -n "$PI" ] || die "usage: ./bin/provision-pi [--target mac|gpu|url] [--rig <name>] [--dry-run] [--no-reboot] <user@pi>"
case "$PI" in *@*) : ;; *) die "target must be user@host (got '$PI')";; esac
PI_USER="${PI%@*}"; PI_HOST="${PI#*@}"
[ -n "$RIG" ] || RIG="$PI_HOST"

# --- secrets + inventory -----------------------------------------------------
SECRETS="$HERE/provisioning/secrets"
RIGFILE="$HERE/provisioning/rigs/$RIG.env"
[ -f "$SECRETS" ] || die "missing $SECRETS  (cp provisioning/secrets.example provisioning/secrets)"
[ -f "$RIGFILE" ] || die "missing $RIGFILE  (cp provisioning/rigs/example.env provisioning/rigs/$RIG.env)"
# shellcheck disable=SC1090
. "$SECRETS"
# shellcheck disable=SC1090
. "$RIGFILE"
[ -n "${UPLOAD_TOKEN:-}" ] || die "UPLOAD_TOKEN is blank in $SECRETS  (openssl rand -hex 32)"

REMOTE_REPO="/home/$PI_USER/robot-umi"
SSHOPTS=(-o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
pssh() { ssh "${SSHOPTS[@]}" "$PI" "$@"; }
PYBIN="$HERE/.venv/bin/python"; [ -x "$PYBIN" ] || PYBIN="python3"

# --- resolve the upload URL from the target ----------------------------------
# --target (or the inventory's RIG_TARGET) picks where episodes upload:
#   mac = a Mac running mac/run_processing.sh, reached via a boot-persistent Pi->Mac
#         tunnel (arm64 CPU GLIM -> HF, no GPU box);
#   gpu = a GPU box's ingest at SERVER_URL (compose decode + CUDA GLIM);
#   url = any raw ingest URL. (lambda is accepted as an alias for gpu.)
TARGET="${TARGET_OVERRIDE:-${RIG_TARGET:-}}"
# Tunnel state: TUNNEL=1 => episodes upload through a boot-persistent Pi->endpoint
# ssh -L tunnel (endpoint reachable only over :22, e.g. a Mac or a cloud GPU box). Each
# tunneled target fills in the local/remote ports, the ssh endpoint, and where the Pi's
# key must be trusted ("@mac" = this Mac locally; anything else = a remote user@host).
TUNNEL=0; TUN_LOCAL=""; TUN_REMOTE=""; TUN_SSH=""; TUN_KEY_DEST=""
case "$TARGET" in
  mac)
    [ -n "${MAC_HOST:-}" ] || die "target=mac needs MAC_HOST (user@mac) in $RIGFILE"
    SERVER_URL="http://localhost:8091/upload"
    TUNNEL=1; TUN_LOCAL=8091; TUN_REMOTE=8091; TUN_SSH="$MAC_HOST"; TUN_KEY_DEST="@mac";;
  gpu|lambda)
    TARGET="gpu"
    if [ -n "${SERVER_SSH:-}" ]; then
      # Box reachable ONLY over SSH (cloud instance, :8080 firewalled): tunnel the Pi's
      # localhost:8080 -> the box's own localhost:8080 (its ingest), exactly like the mac
      # target does on :8091. SERVER_URL is forced local; SERVER_SSH is the box's user@host.
      SERVER_URL="http://localhost:8080/upload"
      TUNNEL=1; TUN_LOCAL=8080; TUN_REMOTE=8080; TUN_SSH="$SERVER_SSH"; TUN_KEY_DEST="$SERVER_SSH"
    else
      [ -n "${SERVER_URL:-}" ] || die "target=gpu needs SERVER_URL (a directly-reachable box ingest) or SERVER_SSH (user@box, to tunnel to an SSH-only box) in $RIGFILE"
    fi;;
  url)
    [ -n "${SERVER_URL:-}" ] || die "target=url needs SERVER_URL in $RIGFILE";;
  *) die "target must be mac | gpu | url (got '${TARGET:-}') — set RIG_TARGET or pass --target";;
esac

echo "provision: rig '$RIG' -> $PI   target=$TARGET  url=$SERVER_URL$([ "$DRYRUN" = 1 ] && echo '   [DRY RUN]')"

render_tunnel_unit() {
  sed -e "s#@USER@#$PI_USER#g" -e "s#@SSH_TARGET@#$TUN_SSH#g" \
    -e "s#@LOCAL_PORT@#$TUN_LOCAL#g" -e "s#@REMOTE_PORT@#$TUN_REMOTE#g" \
    "$HERE/config/systemd/umi-upload-tunnel.service"
}

render_mount_script() {
  # Unquoted heredoc: LOCAL vars ($PI_USER, $SSD_*) expand here; REMOTE vars are \$-escaped.
  cat <<REMOTE
set -e
mp="${SSD_MOUNTPOINT:-/media/$PI_USER/SSD}"
spool="${SPOOL_DIR:-\$mp/umi_spool}"
dev="${SSD_DEVICE:-}"
uid=\$(id -u); gid=\$(id -g)
if ! findmnt -rn "\$mp" >/dev/null 2>&1; then
  if [ -z "\$dev" ]; then
    dev=\$(lsblk -rno NAME,TYPE,FSTYPE,MOUNTPOINT | awk '\$2=="part"&&\$3!=""&&\$4==""&&\$1!~/^mmcblk/{print "/dev/"\$1; exit}')
  fi
  [ -n "\$dev" ] || { echo "no unmounted formatted SSD partition found; set SSD_DEVICE. lsblk:" >&2; lsblk >&2; exit 1; }
  uuid=\$(sudo blkid -s UUID -o value "\$dev")
  fstype=\$(sudo blkid -s TYPE -o value "\$dev")
  # exfat/vfat carry no Unix ownership -> mount with our uid/gid so the user-run
  # recorder can write. ext4/xfs use plain defaults + the chown below. passno=0 for
  # exfat/vfat (NO boot-time fsck — fsck.exfat on a big/dirty volume can stall boot);
  # ext-family keep passno=2 (quick, safe).
  opts="defaults,nofail,x-systemd.device-timeout=30"
  passno=2
  case "\$fstype" in
    exfat|vfat) opts="\$opts,uid=\$uid,gid=\$gid,umask=022"; passno=0 ;;
  esac
  sudo mkdir -p "\$mp"
  grep -q "\$uuid" /etc/fstab || \
    echo "UUID=\$uuid \$mp \$fstype \$opts 0 \$passno" | sudo tee -a /etc/fstab >/dev/null
  sudo mount "\$mp"
fi
sudo mkdir -p "\$spool"
# chown is a no-op on exfat/vfat (ownership comes from the mount opts) — tolerate it.
sudo chown -R "$PI_USER:$PI_USER" "\$spool" 2>/dev/null || true
echo "spool \$spool on \$(findmnt -rno SOURCE,FSTYPE --target "\$spool")"
REMOTE
}

# --- 1. preflight + ephemeral passwordless sudo ------------------------------
log "1/8 preflight + sudo"
pssh true || die "cannot SSH to $PI — is key access set up?"
SUDO_TEMP=0
cleanup() {
  if [ "$SUDO_TEMP" = 1 ]; then
    pssh 'sudo rm -f /etc/sudoers.d/90-umi-provision' 2>/dev/null \
      && echo "provision: removed ephemeral passwordless sudo" || true
  fi
}
trap cleanup EXIT
if [ "$DRYRUN" = 1 ]; then
  echo "(dry run: skipping sudo bootstrap)"
elif pssh 'sudo -n true' 2>/dev/null; then
  echo "passwordless sudo already available"
else
  [ -n "${PI_PASSWORD:-}" ] || die "Pi needs a sudo password; set PI_PASSWORD in $SECRETS"
  printf '%s\n' "$PI_PASSWORD" | pssh \
    "sudo -S -p '' sh -c 'printf \"%s ALL=(ALL) NOPASSWD:ALL\\n\" \"$PI_USER\" > /etc/sudoers.d/90-umi-provision && chmod 440 /etc/sudoers.d/90-umi-provision && visudo -cf /etc/sudoers.d/90-umi-provision'" \
    || die "sudo bootstrap failed (wrong PI_PASSWORD?)"
  SUDO_TEMP=1
  echo "ephemeral passwordless sudo installed (removed at exit)"
fi

# --- 2. deliver the repo -----------------------------------------------------
log "2/8 rsync repo -> $REMOTE_REPO"
# No --delete (don't wipe Pi state); exclude local-only + secret files so the Mac's own
# .env (with its HF token) and the provisioning secrets NEVER land on the Pi.
if [ "$DRYRUN" = 1 ]; then
  echo "(dry run: skipping rsync)"
else
  rsync -a \
    --exclude '.git' --exclude '.venv' --exclude 'target' --exclude '__pycache__' \
    --exclude 'data' --exclude 'provisioning' --exclude '.env' --exclude 'config/umi.yaml' \
    --exclude 'docker-compose.override.yml' \
    -e "ssh ${SSHOPTS[*]}" "$HERE/" "$PI:$REMOTE_REPO/"
fi

# --- 3. rig config -----------------------------------------------------------
log "3/8 rig config"
CFG_TMP="$(mktemp)"
if [ -n "${RIG_CONFIG_FILE:-}" ]; then
  cp "$HERE/$RIG_CONFIG_FILE" "$CFG_TMP"
  echo "using $RIG_CONFIG_FILE verbatim"
else
  CAM="${CAMERA_DEVICE:-}"
  if [ -z "$CAM" ]; then
    # A USB UVC camera's capture node is …-usb-…-video-index0. Match usb- specifically
    # to skip the Pi's onboard codec / ISP (pisp_be) nodes and the usbv2- speed alias.
    CAM="$(pssh 'ls /dev/v4l/by-path/*usb-*-video-index0 2>/dev/null | head -1')" || true
    [ -n "$CAM" ] && echo "discovered camera: $CAM" \
      || echo "WARN: no USB camera by-path found on the Pi — set CAMERA_DEVICE in $RIGFILE"
  fi
  cat > "$CFG_TMP" <<YAML
version: 1
motion_source: "${MOTION_SOURCE:-lidar}"
task: "${TASK:-umi demo task}"
controls:
  buttons: { record: ${BTN_RECORD:-12}, quit: ${BTN_QUIT:-16}, mode: ${BTN_MODE:-22} }
  display: { kind: ${LCD_KIND:-lcd}, dc: ${LCD_DC:-25}, rst: ${LCD_RST:-27}, bl: ${LCD_BL:-18} }
umis:
  ${UMI_NAME:-umi1}:
    camera:
      device: "${CAM}"
      width: ${CAMERA_WIDTH:-800}
      height: ${CAMERA_HEIGHT:-600}
      fps: ${CAMERA_FPS:-30}
      exposure: ${CAMERA_EXPOSURE:-100}
      calib: "${CAMERA_CALIB:-config/calib/umi1_calib.npz}"
    lidar:
      type: "${LIDAR_TYPE:-auto}"
      iface: "${LIDAR_IFACE:-eth0}"
      host_ip: "${LIDAR_HOST_IP:-192.168.1.102}"
      lidar_ip: "${LIDAR_IP:-192.168.1.200}"
    gripper:
      tag_ids: [${GRIPPER_TAGS:-0, 1}]
      stride: 2
YAML
fi
# Validate locally with the repo's own parser BEFORE pushing (catches pin collisions,
# non-4:3 camera, unknown keys) so a bad rig never reaches the Pi.
PYTHONPATH="$HERE/common/robot-umi-core/src" "$PYBIN" -c \
  'import sys; from robot_umi_core.config import load_rig_config; load_rig_config(sys.argv[1])' \
  "$CFG_TMP" || die "rendered umi.yaml is invalid (see error above)"
echo "--- config/umi.yaml ---"; sed 's/^/    /' "$CFG_TMP"

# --- 4. .env -----------------------------------------------------------------
log "4/8 .env (Pi scope — no HF token)"
# Two-Pi bimanual coordination (from the rig inventory). Solo => nothing here; the generic
# umi-recorder unit reads these, so no per-role systemd edit is needed.
COORD_ENV=""
if [ -n "${ROLE:-}" ] && [ "$ROLE" != "solo" ]; then
  COORD_ENV="ROBOT_UMI_ROLE=$ROLE"
  [ -n "${TIME_REF:-}" ] && COORD_ENV="$COORD_ENV
ROBOT_UMI_TIME_REF=$TIME_REF"
  if [ "$ROLE" = "leader" ]; then
    [ -n "${PEER_HOST:-}" ] || die "ROLE=leader needs PEER_HOST (the follower's IP) in $RIGFILE"
    COORD_ENV="$COORD_ENV
ROBOT_UMI_PEER=$PEER_HOST:${CONTROL_PORT:-9140}"
  else
    COORD_ENV="$COORD_ENV
ROBOT_UMI_LISTEN_PORT=${CONTROL_PORT:-9140}"
  fi
  echo "coordination: role=$ROLE  peer=${PEER_HOST:-n/a}:${CONTROL_PORT:-9140}  time_ref=${TIME_REF:-n/a}"
fi
ENV_TMP="$(mktemp)"
cat > "$ENV_TMP" <<ENV
# Rendered by bin/provision-pi for rig '$RIG'. Edit the inventory + re-provision, not this.
ROBOT_UMI_SERVER_URL=$SERVER_URL
ROBOT_UMI_UPLOAD_TOKEN=$UPLOAD_TOKEN
ROBOT_UMI_CONFIG=config/umi.yaml
ROBOT_UMI_SPOOL_DIR=${SPOOL_DIR:-/media/$PI_USER/SSD/umi_spool}
$COORD_ENV
ENV
echo "server_url=$SERVER_URL  spool=${SPOOL_DIR:-/media/$PI_USER/SSD/umi_spool}"

if [ "$DRYRUN" = 1 ]; then
  rm -f "$CFG_TMP" "$ENV_TMP"
  echo; echo "provision: DRY RUN complete — validated + rendered; nothing pushed/mounted/installed."
  exit 0
fi

pssh "mkdir -p $REMOTE_REPO/config"
scp "${SSHOPTS[@]}" -q "$CFG_TMP" "$PI:$REMOTE_REPO/config/umi.yaml"
scp "${SSHOPTS[@]}" -q "$ENV_TMP" "$PI:$REMOTE_REPO/.env"
rm -f "$CFG_TMP" "$ENV_TMP"

# --- 5. mount the SSD --------------------------------------------------------
if [ "${ALLOW_SD_SPOOL:-0}" = "1" ]; then
  log "5/8 spool — ALLOW_SD_SPOOL=1: no SSD, spooling to $SPOOL_DIR on the SD card"
  pssh "mkdir -p '$SPOOL_DIR'"
else
  log "5/8 SSD spool (mount existing + fstab nofail)"
  render_mount_script | pssh 'bash -s' || die "SSD mount failed (check the disk / set SSD_DEVICE, or set ALLOW_SD_SPOOL=1 to spool to the SD card)"
fi

# --- 6. run the installer ----------------------------------------------------
log "6/8 install_pi.sh — apt/rust/venv/build/setcap/lidar-net/PTP/unit (~20-40 min)"
pssh "cd $REMOTE_REPO && DEBIAN_FRONTEND=noninteractive ROBOT_UMI_ALLOW_SD_SPOOL=${ALLOW_SD_SPOOL:-0} PATH=\$HOME/.cargo/bin:\$HOME/.local/bin:\$PATH device/scripts/install_pi.sh" \
  || die "install_pi.sh failed (see output above)"

# --- 6b. chrony (cross-Pi time sync for bimanual pairs) ----------------------
if [ -n "${TIME_REF:-}" ]; then
  log "chrony — discipline this Pi's clock to $TIME_REF (cross-Pi bimanual sync)"
  # Append the shared reference (idempotent), enable chrony, and kill WiFi power-save
  # (its jitter is the main enemy of sub-frame cross-Pi sync). Best-effort throughout.
  pssh "sudo apt-get install -y -q chrony >/dev/null 2>&1 || true
    L='server $TIME_REF iburst minpoll 2 maxpoll 4'
    grep -qF \"\$L\" /etc/chrony/chrony.conf 2>/dev/null || echo \"\$L\" | sudo tee -a /etc/chrony/chrony.conf >/dev/null
    sudo systemctl enable --now chrony >/dev/null 2>&1 || sudo systemctl enable --now chronyd >/dev/null 2>&1 || true
    sudo systemctl restart chrony >/dev/null 2>&1 || sudo systemctl restart chronyd >/dev/null 2>&1 || true
    for w in /sys/class/net/wl*; do sudo iw dev \$(basename \$w) set power_save off 2>/dev/null || true; done" \
    || echo "WARN: chrony setup had issues (cross-Pi sync may be degraded); check 'chronyc tracking'"
fi

# --- 7. upload target --------------------------------------------------------
log "7/8 upload target ($TARGET)"
if [ "$TUNNEL" = 1 ]; then
  # Give the Pi a key and trust it on the tunnel endpoint (this Mac, or the box).
  pssh 'test -f ~/.ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519 >/dev/null'
  PIKEY="$(pssh 'cat ~/.ssh/id_ed25519.pub')"
  if [ "$TUN_KEY_DEST" = "@mac" ]; then
    # Endpoint is THIS Mac (we're running here): trust the Pi's key locally.
    AUTH="$HOME/.ssh/authorized_keys"
    mkdir -p "$HOME/.ssh"; touch "$AUTH"; chmod 600 "$AUTH"
    if grep -qF "$PIKEY" "$AUTH"; then echo "Pi key already trusted on this Mac"; else
      echo "$PIKEY" >> "$AUTH"; echo "added the Pi's key to this Mac's authorized_keys"
    fi
  else
    # Endpoint is a remote box: append the Pi's key to ITS authorized_keys over SSH.
    printf '%s\n' "$PIKEY" | ssh "${SSHOPTS[@]}" "$TUN_KEY_DEST" \
      'umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; k=$(cat); grep -qF "$k" ~/.ssh/authorized_keys || printf "%s\n" "$k" >> ~/.ssh/authorized_keys' \
      && echo "trusted the Pi's key on $TUN_KEY_DEST" \
      || die "could not add the Pi's key to $TUN_KEY_DEST (is it SSH-reachable from this Mac?)"
  fi
  render_tunnel_unit | pssh 'sudo tee /etc/systemd/system/umi-upload-tunnel.service >/dev/null'
  pssh 'sudo systemctl daemon-reload && sudo systemctl enable umi-upload-tunnel >/dev/null'
  echo "umi-upload-tunnel enabled (Pi localhost:$TUN_LOCAL -> $TUN_SSH:$TUN_REMOTE)."
else
  echo "direct upload to $SERVER_URL — no tunnel needed."
fi

# --- 8. reboot + verify ------------------------------------------------------
if [ "$REBOOT" = 0 ]; then
  echo; echo "provision: --no-reboot set. Reboot the Pi to bring up the recorder + SSD + tunnel."
  exit 0
fi
log "8/8 reboot + verify"
pssh 'sudo systemctl reboot' 2>/dev/null || true
echo "rebooting $PI; waiting for it to come back..."
sleep 20
back=0
for _ in $(seq 1 36); do pssh true 2>/dev/null && { back=1; break; }; sleep 5; done
[ "$back" = 1 ] || die "Pi did not come back after reboot — check it manually"
pssh 'bash -s' <<'VERIFY' || true
set +e
echo "--- umi-recorder ---"; systemctl is-active umi-recorder \
  || { echo "(recent log)"; journalctl -u umi-recorder -n 8 --no-pager; }
sp="$(. ~/robot-umi/.env 2>/dev/null; echo "${ROBOT_UMI_SPOOL_DIR:-/}")"
echo "--- spool fs ($sp) ---"; df -h --output=source,target "$sp" 2>/dev/null | tail -1
echo "--- units ---"; systemctl --no-legend --plain list-units 'umi-*' 2>/dev/null | awk '{print $1, $4}'
VERIFY
echo; echo "provision: done. Press the record button to capture — episodes queue on the SSD"
echo "and upload to '$TARGET' when it's reachable (recording never waits on the target)."
