#!/usr/bin/env bash
# Provision the single Ubuntu processing server from provisioning/pair.env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PAIR_CONFIG="${PAIR_CONFIG:-$ROOT/provisioning/pair.env}"
die() { echo "provision-server: $*" >&2; exit 1; }
log() { echo; echo "=== $* ==="; }

case "${1:-}" in
  "") ;;
  -h|--help) echo "usage: bin/provision-server"; exit 0 ;;
  *) die "unexpected argument '$1'" ;;
esac
[ -f "$PAIR_CONFIG" ] || die "missing $PAIR_CONFIG (copy provisioning/pair.env.example)"
# shellcheck disable=SC1090
. "$PAIR_CONFIG"
[ -n "${SERVER:-}" ] || die "SERVER is blank in $PAIR_CONFIG"
case "$SERVER" in *@*) ;; *) die "SERVER must be user@host" ;; esac

SERVER_USER="${SERVER%@*}"
REMOTE_REPO="/home/$SERVER_USER/umi-flow"
case "${DATA_NAMESPACE:-}" in
  "") SERVER_DATA_DIR="$REMOTE_REPO/data" ;;
  "."|".."|*[!A-Za-z0-9._-]*)
    die "DATA_NAMESPACE may contain only letters, numbers, dot, underscore, and hyphen"
    ;;
  *) SERVER_DATA_DIR="$REMOTE_REPO/data/$DATA_NAMESPACE" ;;
esac
SSH_OPTS=(-o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
server_ssh() { ssh "${SSH_OPTS[@]}" "$SERVER" "$@"; }

log "1/4 preflight: $SERVER"
server_ssh true || die "cannot SSH to $SERVER"
server_ssh 'sudo -n true' >/dev/null 2>&1 || die "$SERVER requires passwordless sudo"

log "2/4 deploy repository"
server_ssh "mkdir -p '$REMOTE_REPO'"
rsync -a --delete \
  --exclude '.git' --exclude '.venv' --exclude 'data' --exclude '__pycache__' \
  --exclude 'provisioning' --exclude '.env' --exclude 'config/umi.yaml' \
  --exclude 'device/v4l2_recorder/target' --exclude '*.rrd' \
  --exclude 'docker-compose.override.yml' \
  -e "ssh ${SSH_OPTS[*]}" "$ROOT/" "$SERVER:$REMOTE_REPO/"

log "3/4 render internal server environment"
# HF_REPO_ID/HF_TOKEN come from pair.env; blank = local-only dataset (no Hub push).
server_ssh "cat > '$REMOTE_REPO/.env'" <<ENV
# Rendered by bin/provision-server. Edit provisioning/pair.env and re-provision, not this.
DATA_DIR=$SERVER_DATA_DIR
HF_REPO_ID=${HF_REPO_ID:-}
HF_TOKEN=${HF_TOKEN:-}
ENV

log "4/4 install server"
server_ssh "cd '$REMOTE_REPO' && bash server/scripts/install_server.sh" \
  || die "install_server.sh failed on $SERVER"

code="$(server_ssh "curl -s -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:8080/upload")"
[ "$code" = 400 ] || die "ingest health check returned HTTP $code, expected 400"
server_ssh 'systemctl is-active --quiet umi-runner' || die "umi-runner is not active"
echo "server ready: $SERVER"
