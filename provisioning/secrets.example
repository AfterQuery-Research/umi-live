# provisioning/secrets — LOCAL, gitignored. Copy to `provisioning/secrets` and fill in.
# provision_pi.sh sources this. The HF token is NOT here — it never goes near a recorder
# Pi; it lives only on the processing box (mac/server .env).

# Pi login password. Used ONCE to bootstrap ephemeral passwordless sudo, which is torn
# down at the end of provisioning. Leave blank if the Pi already has passwordless sudo.
PI_PASSWORD=""

# Shared upload token: identical on the Pi and the processing box (the recorder sends it
# as X-Upload-Token; the ingest rejects a mismatch). Generate once with:
#   openssl rand -hex 32
UPLOAD_TOKEN=""
