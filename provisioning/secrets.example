# provisioning/secrets — LOCAL, gitignored. Copy to `provisioning/secrets` and fill in.
# The ONE home for every secret. provision_server.sh and provision_pi.sh source it and
# fan each value out to exactly the machines that need it — you never paste a secret
# into a second file.

# Pi login password (sudo). Used ONCE per provisioning run to bootstrap ephemeral
# passwordless sudo, torn down at the end. Leave blank if your Pis are flashed with
# passwordless sudo already. Never leaves this machine, never stored on a Pi.
PI_PASSWORD=""

# Shared upload token: the recorder sends it as X-Upload-Token, the ingest rejects a
# mismatch. Written here ONCE; provision_server.sh puts it on the box and
# provision_pi.sh puts it on each Pi. Generate with:  openssl rand -hex 32
UPLOAD_TOKEN=""

# HuggingFace WRITE-scope token for the dataset push. Goes ONLY to the processing
# host (provision_server.sh) — by design it can never reach a recorder Pi. Leave
# blank to keep datasets local-only.
HF_TOKEN=""
