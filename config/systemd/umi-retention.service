# Root is intentional: decode containers create root-owned MCAP files.
[Unit]
Description=Prune reconstructible UMI processing artifacts

[Service]
Type=oneshot
User=root
WorkingDirectory=@REPO@
Environment=DATA_DIR=./data
EnvironmentFile=@REPO@/.env
ExecStart=@REPO@/.venv/bin/python server/scripts/prune_completed.py --retention-hours 1
