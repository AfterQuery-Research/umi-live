.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
target/
umi_flow_spool/
# Legacy default retained during the environment/path migration.
robot_umi_spool/
config/umi.yaml
config/ee_calib.umi*.json
data/
*.log
# Machine-rendered runtime configuration. It is not user-edited.
.env
.pair-wifi.env
# Host-specific CPU/GPU compose override written by install_server.sh — must not
# be committed (a CPU host's copy would silently downgrade a GPU box to CPU SLAM).
docker-compose.override.yml
# Recoverable raw calibration detections written beside each calibration output.
*.views.npz
# Physical closed/open endpoints are local to one gripper pair.
config/calib/*_gripper_range.json
# The single user-edited deployment inventory.
provisioning/pair.env
# Generated once and reused so re-provisioning cannot strand the follower.
provisioning/.pair-wifi-psk
# Ignore inventories created by versions before the dual-only setup.
provisioning/secrets
provisioning/server.env
provisioning/rigs/*.env

# Local research artifacts and experiment workspace.
/dataset-filtering/reports/
/dataset-filtering-tests/
