# provisioning/server.env — LOCAL, gitignored (cp server.env.example -> server.env).
# Settings for the processing host, consumed by ./provision_server.sh, which renders
# them (plus the secrets file) into the box's .env and runs the installer remotely.
# Secrets do NOT go here — UPLOAD_TOKEN / HF_TOKEN / PI_PASSWORD live in
# provisioning/secrets, written once and fanned out.

# HuggingFace dataset repo episodes append to (created on first push). The state
# dimension (6-D solo vs 12-D bimanual) is frozen by the FIRST episode — use a new
# repo id for a new rig shape.
REPO_ID=""

# Push each episode to the Hub (1) or keep datasets local to the box (0).
PUSH_TO_HUB="1"
# Pushed repo visibility: 1 = public, 0 = private.
PUBLIC="0"

# Extra runner flags. Bimanual two-Pi rigs MUST set "--pair" or the leader/follower
# uploads are never merged into 12-D episodes. Solo rigs: leave empty.
RUNNER_ARGS="--pair"
