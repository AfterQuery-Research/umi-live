#!/usr/bin/env bash
# Render one processed server episode into a synchronized four-panel conference demo.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PAIR_CONFIG="${PAIR_CONFIG:-$ROOT/provisioning/pair.env}"
die() { echo "render-demo: $*" >&2; exit 1; }

EPISODE="latest"
OPERATOR=""
OFFSET="0"
OUTPUT=""
PREVIEW=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --episode) EPISODE="${2:?--episode needs an id or latest}"; shift 2 ;;
    --operator-video) OPERATOR="${2:?--operator-video needs a path}"; shift 2 ;;
    --operator-offset-s) OFFSET="${2:?--operator-offset-s needs seconds}"; shift 2 ;;
    --output) OUTPUT="${2:?--output needs a path}"; shift 2 ;;
    --preview-seconds) PREVIEW="${2:?--preview-seconds needs seconds}"; shift 2 ;;
    -h|--help)
      echo "usage: bin/render-demo [--episode ID|latest] --operator-video PATH [--operator-offset-s S] [--output PATH] [--preview-seconds S]"
      exit 0
      ;;
    *) die "unknown argument '$1'" ;;
  esac
done

[ -f "$PAIR_CONFIG" ] || die "missing $PAIR_CONFIG"
# shellcheck disable=SC1090
. "$PAIR_CONFIG"
[ -n "${SERVER:-}" ] || die "SERVER is blank in $PAIR_CONFIG"
[ -n "$OPERATOR" ] || die "--operator-video is required"
[ -f "$OPERATOR" ] || die "operator video not found: $OPERATOR"
case "$EPISODE" in latest|paired_[A-Za-z0-9._-]*) ;; *) die "invalid episode '$EPISODE'" ;; esac

SERVER_USER="${SERVER%@*}"
REMOTE_REPO="/home/$SERVER_USER/umi-flow"
case "${DATA_NAMESPACE:-}" in
  "") REMOTE_DATA="$REMOTE_REPO/data" ;;
  "."|".."|*[!A-Za-z0-9._-]*) die "invalid DATA_NAMESPACE" ;;
  *) REMOTE_DATA="$REMOTE_REPO/data/$DATA_NAMESPACE" ;;
esac
SSH=(-o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o BatchMode=yes)

if [ "$EPISODE" = latest ]; then
  EPISODE="$(ssh "${SSH[@]}" "$SERVER" \
    "find '$REMOTE_DATA/derived' -mindepth 3 -maxdepth 3 -path '*/dataset/COMPLETE' -printf '%T@ %h\\n' 2>/dev/null | sort -nr | head -1 | sed 's#^[^ ]* ##; s#/dataset$##; s#.*/##'")"
  [ -n "$EPISODE" ] || die "no fully processed paired episode in $REMOTE_DATA"
fi

REMOTE_RAW="$REMOTE_DATA/raw_episodes/$EPISODE"
REMOTE_DERIVED="$REMOTE_DATA/derived/$EPISODE"
REMOTE_DEMO="$REMOTE_DATA/demos/$EPISODE"
ssh "${SSH[@]}" "$SERVER" \
  "test -d '$REMOTE_RAW' && test -f '$REMOTE_DERIVED/dataset/COMPLETE' && mkdir -p '$REMOTE_DEMO'" \
  || die "$EPISODE is not fully processed"

suffix="${OPERATOR##*.}"
lower_suffix="$(printf '%s' "$suffix" | tr '[:upper:]' '[:lower:]')"
case "$lower_suffix" in mp4|mov|mkv|avi|m4v|webm) suffix="$lower_suffix" ;; *) suffix="video" ;; esac
REMOTE_OPERATOR="$REMOTE_DEMO/operator.$suffix"
REMOTE_OUTPUT="$REMOTE_DEMO/final.mp4"
echo "uploading operator video for $EPISODE"
rsync -a --partial --progress -e "ssh ${SSH[*]}" "$OPERATOR" "$SERVER:$REMOTE_OPERATOR"
rsync -a -e "ssh ${SSH[*]}" "$ROOT/tools/render_slam_demo.py" "$SERVER:$REMOTE_REPO/tools/render_slam_demo.py"

echo "rendering synchronized 3840x720 video on $SERVER"
REMOTE_PREVIEW="${PREVIEW:-none}"
ssh "${SSH[@]}" "$SERVER" bash -s -- \
  "$REMOTE_RAW" "$REMOTE_DERIVED" "$REMOTE_OPERATOR" "$REMOTE_OUTPUT" "$OFFSET" "$REMOTE_PREVIEW" <<'REMOTE'
set -euo pipefail
raw="$1"; derived="$2"; operator="$3"; output="$4"; offset="$5"; preview="$6"
cd "$HOME/umi-flow"
export PATH="$HOME/.local/bin:$PATH"
operator_render="$operator"
transfer="$(ffprobe -v error -select_streams v:0 -show_entries stream=color_transfer -of default=nw=1:nk=1 "$operator")"
case "$transfer" in
  arib-std-b67|smpte2084)
    operator_render="${operator%.*}.sdr.mp4"
    if [ ! -f "$operator_render" ] || [ "$operator" -nt "$operator_render" ]; then
      echo "tone-mapping operator video from $transfer HDR to BT.709 SDR"
      ffmpeg -nostdin -hide_banner -loglevel error -y -i "$operator" -an \
        -vf 'zscale=t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv,format=yuv420p' \
        -c:v libx264 -preset fast -crf 16 -movflags +faststart \
        -color_primaries bt709 -color_trc bt709 -colorspace bt709 "$operator_render"
    fi
    ;;
esac
args=("$raw" "$derived" "$output" --operator-video "$operator_render" --operator-offset-s "$offset")
[ "$preview" = none ] || args+=(--preview-seconds "$preview")
uv run --package umi-flow-server python tools/render_slam_demo.py "${args[@]}"
REMOTE

if [ -z "$OUTPUT" ]; then
  mkdir -p "$ROOT/demo-output"
  OUTPUT="$ROOT/demo-output/${EPISODE}_demo.mp4"
fi
mkdir -p "$(dirname "$OUTPUT")"
scp "${SSH[@]}" "$SERVER:$REMOTE_OUTPUT" "$OUTPUT"
echo "demo ready: $OUTPUT"
