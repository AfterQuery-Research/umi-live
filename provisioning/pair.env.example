# Copy to provisioning/pair.env and set these values.
SERVER="<server-user>@<server-ip>"
LEADER="<leader-user>@<leader-ip>"
FOLLOWER="<follower-user>@<follower-ip>"
TASK="bimanual demonstration"
# Optional isolated server data tree for a new physical pair or collection campaign.
# Blank preserves the default data tree; a value such as "pair2-test" starts fresh
# without deleting or mixing any existing raw, derived, or LeRobot data.
DATA_NAMESPACE=""
# Optional cross-lidar registration. When true, processing places both UMI trajectories
# in umi1's metric frame. It does not change recording on either client.
ALIGNMENT_ENABLED=false
# Dedicated leader/follower network. Set false to use FOLLOWER's configured address.
LEADER_HOTSPOT_ENABLED=true
PAIR_WIFI_SSID="umi-flow-pair"
PAIR_WIFI_PASSWORD="<private-wpa-password>"
PAIR_WIFI_CHANNEL=44
PAIR_WIFI_COUNTRY="US"
# A dedicated leader adapter permits its normal wlan0 connection to stay online.
# The follower uses its radio exclusively for the leader link while this mode is enabled.
PAIR_WIFI_LEADER_RADIO_IFACE="wlan0"
PAIR_WIFI_FOLLOWER_RADIO_IFACE="wlan0"
PAIR_WIFI_UPLINK_IFACE="wlan0"
# Optional HuggingFace publishing: when both are set, every episode mirrors the dataset
# (+ archives the raw episode) to this Hub repo — the offsite copy. Blank = local-only.
HF_REPO_ID=""
HF_TOKEN=""
