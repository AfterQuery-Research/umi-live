+void Preprocess::robosense_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pl_corn.clear();
+  pl_full.clear();
+
+  pcl::PointCloud<robosense_ros::Point> pl_orig;
+  pcl::fromROSMsg(*msg, pl_orig);
+  int plsize = pl_orig.points.size();
+  if (plsize == 0)
+    return;
+  pl_surf.reserve(plsize);
+
+  // RoboSense points carry an ABSOLUTE per-point timestamp (seconds, double).
+  // FAST-LIO wants per-point time relative to the scan start, in ms (curvature).
+  double t0 = 0.0;
+  for (int i = 0; i < plsize; i++)
+  {
+    if (pl_orig.points[i].timestamp > 0.0)
+    {
+      t0 = pl_orig.points[i].timestamp;
+      break;
     }
   }
+
+  for (int i = 0; i < plsize; i++)
+  {
+    if (i % point_filter_num != 0)
+      continue;
+    const robosense_ros::Point &sp = pl_orig.points[i];
+    if (!std::isfinite(sp.x) || !std::isfinite(sp.y) || !std::isfinite(sp.z))
+      continue;
+    double dist2 = sp.x * sp.x + sp.y * sp.y + sp.z * sp.z;
+    if (dist2 < (blind * blind))
+      continue;
+
+    PointType added_pt;
+    added_pt.normal_x = 0;
+    added_pt.normal_y = 0;
+    added_pt.normal_z = 0;
+    added_pt.x = sp.x;
+    added_pt.y = sp.y;
+    added_pt.z = sp.z;
+    added_pt.intensity = sp.intensity;
+    double rel_ms = (sp.timestamp - t0) * 1000.0;  // curvature unit: ms
+    added_pt.curvature = (rel_ms > 0.0) ? rel_ms : 0.0;
+
+    pl_surf.points.push_back(added_pt);
+  }
 }
 
