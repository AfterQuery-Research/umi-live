# UMI pipeline runner: the filesystem state machine that drives decode -> GLIM ->
# gripper -> dataset over the shared DATA_DIR. install_server.sh substitutes
# @REPO@/@USER@ and installs this to /etc/systemd/system/umi-runner.service.
# Survives SSH logout/reboot (the old failure: the runner died with the session).
# Runs from the repo so `docker compose run` finds docker-compose.yml + .env, and
# runs gripper/dataset in-process (needs the umi-live-server venv + ffmpeg).
[Unit]
Description=UMI pipeline runner
Wants=network-online.target
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=@USER@
SupplementaryGroups=docker
WorkingDirectory=@REPO@
# Default DATA_DIR first; EnvironmentFile overrides it when .env sets one. Without
# this, deleting DATA_DIR from .env would expand ${DATA_DIR} to empty and the
# runner would use the repo root while compose mounts ./data — a split brain.
Environment=DATA_DIR=./data
EnvironmentFile=@REPO@/.env
ExecStart=@REPO@/.venv/bin/python server/scripts/runner.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
