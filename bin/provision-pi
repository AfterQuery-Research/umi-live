#!/usr/bin/env bash
# Internal helper used by bin/provision-pair. Public setup always provisions both clients.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PAIR_CONFIG="${PAIR_CONFIG:-$ROOT/provisioning/pair.env}"
die() { echo "provision-pi: $*" >&2; exit 1; }
log() { echo; echo "=== $* ==="; }

ROLE=""; DRY_RUN=0; REBOOT=1
while [ "$#" -gt 0 ]; do
  case "$1" in
    --role) ROLE="${2:?--role needs leader or follower}"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --no-reboot) REBOOT=0; shift ;;
    -h|--help) echo "usage: bin/provision-pi --role leader|follower [--dry-run] [--no-reboot]"; exit 0 ;;
    *) die "unknown argument '$1'" ;;
  esac
done
case "$ROLE" in leader|follower) ;; *) die "--role must be leader or follower" ;; esac
[ -f "$PAIR_CONFIG" ] || die "missing $PAIR_CONFIG (copy provisioning/pair.env.example)"
# shellcheck disable=SC1090
. "$PAIR_CONFIG"

for name in SERVER LEADER FOLLOWER TASK; do
  [ -n "${!name:-}" ] || die "$name is blank in $PAIR_CONFIG"
done
case "${ALIGNMENT_ENABLED:-false}" in
  true|false) ;;
  *) die "ALIGNMENT_ENABLED must be true or false in $PAIR_CONFIG" ;;
esac
LEADER_HOTSPOT_ENABLED="${LEADER_HOTSPOT_ENABLED:-false}"
PAIR_WIFI_SSID="umi-flow-pair"
PAIR_WIFI_PASSWORD="${UMI_PAIR_PROVISION_PSK:-}"
PAIR_WIFI_CHANNEL=44
PAIR_WIFI_COUNTRY="US"
case "$LEADER_HOTSPOT_ENABLED" in
  true|false) ;;
  *) die "LEADER_HOTSPOT_ENABLED must be true or false in $PAIR_CONFIG" ;;
esac
case "$SERVER" in *@*) ;; *) die "SERVER must be user@host" ;; esac
case "$LEADER" in *@*) ;; *) die "LEADER must be user@host" ;; esac
case "$FOLLOWER" in *@*) ;; *) die "FOLLOWER must be user@host" ;; esac

PAIR_WIFI_RADIO_IFACE="wlan0"
PAIR_WIFI_UPLINK_IFACE="wlan0"
PAIR_WIFI_IFACE="umi-pair0"
if [ "$ROLE" = follower ]; then
  PAIR_WIFI_IFACE="$PAIR_WIFI_RADIO_IFACE"
fi
PAIR_WIFI_LEADER_IP="10.42.0.1"
PAIR_WIFI_FOLLOWER_IP="10.42.0.2"
PAIR_WIFI_SUBNET="10.42.0.0/24"
if [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
  case "$PAIR_WIFI_PASSWORD" in
    *[!A-Za-z0-9._-]*|"")
      die "pair Wi-Fi credential is missing; run bin/provision-pair instead"
      ;;
  esac
  [ "${#PAIR_WIFI_PASSWORD}" -ge 8 ] && [ "${#PAIR_WIFI_PASSWORD}" -le 63 ] \
    || die "pair Wi-Fi credential must be 8-63 characters"
fi

PYTHON="$ROOT/.venv/bin/python"; [ -x "$PYTHON" ] || PYTHON="python3"
GRIPPER_TAG_CONFIG="$ROOT/config/gripper_tags.yaml"
[ -f "$GRIPPER_TAG_CONFIG" ] || die "gripper tag config not found: $GRIPPER_TAG_CONFIG"

if [ "$ROLE" = leader ]; then
  PI="$LEADER"; UMI_NAME="umi1"; CAMERA_CALIB="config/calib/umi1_calib.npz"
  DISPLAY_KIND="lcd"
else
  PI="$FOLLOWER"; UMI_NAME="umi2"; CAMERA_CALIB="config/calib/umi2_calib.npz"
  DISPLAY_KIND="none"
fi
ALIGNMENT_YAML=""
if [ "$ROLE" = leader ] && [ "${ALIGNMENT_ENABLED:-false}" = true ]; then
  ALIGNMENT_YAML="alignment:
  enabled: true
  reference: umi1
  tier: 1"
fi
GRIPPER_CALIB_DIR="${GRIPPER_CALIB_DIR:-$ROOT/config/calib}"
GRIPPER_RANGE="$GRIPPER_CALIB_DIR/${UMI_NAME}_gripper_range.json"
TAGS="$(
  PYTHONPATH="$ROOT/common/umi-flow-core/src" "$PYTHON" - "$GRIPPER_TAG_CONFIG" "$UMI_NAME" <<'PY'
import sys

from umi_flow_core.config import load_gripper_tag_pairs

pair = load_gripper_tag_pairs(sys.argv[1])[sys.argv[2]]
print(", ".join(str(tag_id) for tag_id in pair))
PY
)" || die "invalid gripper tag config: $GRIPPER_TAG_CONFIG"
[ -f "$ROOT/$CAMERA_CALIB" ] || die "$ROLE camera calibration not found: $CAMERA_CALIB"
GRIPPER_CALIB_YAML=""
GRIPPER_REPORT="uncalibrated (legacy millimetre feature)"
if [ -f "$GRIPPER_RANGE" ]; then
  read -r GRIPPER_CLOSED_MM GRIPPER_OPEN_MM <<EOF
$("$PYTHON" - "$GRIPPER_RANGE" "$UMI_NAME" <<'PY'
import json, math, sys

report = json.load(open(sys.argv[1]))
if report.get("gripper") != sys.argv[2]:
    raise SystemExit(f"calibration gripper {report.get('gripper')!r} != {sys.argv[2]!r}")
closed = float(report["closed_width_mm"])
opened = float(report["open_width_mm"])
if not math.isfinite(closed) or not math.isfinite(opened) or opened <= closed:
    raise SystemExit("gripper calibration endpoints must be finite and open > closed")
print(closed, opened)
PY
)
EOF
  GRIPPER_CALIB_YAML="      closed_width_mm: $GRIPPER_CLOSED_MM
      open_width_mm: $GRIPPER_OPEN_MM"
  GRIPPER_REPORT="calibrated [$GRIPPER_CLOSED_MM, $GRIPPER_OPEN_MM] mm -> [0, 1]"
else
  echo "WARN: $GRIPPER_RANGE missing; run the interactive calibration and re-provision"
fi

PI_USER="${PI%@*}"
REMOTE_REPO="/home/$PI_USER/umi-flow"
SPOOL_DIR="/home/$PI_USER/umi-recordings"
SSH_OPTS=(-o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new -o BatchMode=yes)
SSH_JUMP=""
SSH_TARGET="$PI"
use_private_follower_transport() {
  SSH_JUMP="$LEADER"
  SSH_TARGET="$PI_USER@$PAIR_WIFI_FOLLOWER_IP"
}
if [ "$ROLE" = follower ] && [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
  use_private_follower_transport
  if ! ssh "${SSH_OPTS[@]}" -J "$SSH_JUMP" "$SSH_TARGET" true >/dev/null 2>&1; then
    SSH_JUMP=""
    SSH_TARGET="$PI"
    if ! ssh "${SSH_OPTS[@]}" "$SSH_TARGET" true >/dev/null 2>&1; then
      use_private_follower_transport
      echo "waiting for follower to rejoin the private network..."
      for _ in $(seq 1 30); do
        if ssh "${SSH_OPTS[@]}" -J "$SSH_JUMP" "$SSH_TARGET" true \
          >/dev/null 2>&1; then
          break
        fi
        sleep 2
      done
    fi
  fi
fi
pssh() {
  if [ -n "$SSH_JUMP" ]; then
    ssh "${SSH_OPTS[@]}" -J "$SSH_JUMP" "$SSH_TARGET" "$@"
  else
    ssh "${SSH_OPTS[@]}" "$SSH_TARGET" "$@"
  fi
}
pcopy() {
  if [ -n "$SSH_JUMP" ]; then
    scp "${SSH_OPTS[@]}" -J "$SSH_JUMP" -q "$1" "$SSH_TARGET:$2"
  else
    scp "${SSH_OPTS[@]}" -q "$1" "$SSH_TARGET:$2"
  fi
}

CFG_TMP="$(mktemp)"; ENV_TMP="$(mktemp)"; PAIR_WIFI_TMP="$(mktemp)"; SUDO_TEMP=0
cleanup() {
  rm -f "$CFG_TMP" "$ENV_TMP" "$PAIR_WIFI_TMP"
  if [ "$SUDO_TEMP" = 1 ]; then
    pssh 'sudo -n rm -f /etc/sudoers.d/90-umi-provision' >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

remove_temporary_sudo() {
  if [ "$SUDO_TEMP" = 1 ]; then
    pssh 'sudo -n rm -f /etc/sudoers.d/90-umi-provision' \
      || die "could not remove temporary sudo access from $PI"
    SUDO_TEMP=0
  fi
}

log "1/7 preflight: $ROLE client $PI"
if [ "$ROLE" = follower ] && [ "$LEADER_HOTSPOT_ENABLED" = false ] \
  && [ "$DRY_RUN" = 0 ]; then
  echo "waiting for follower on configured network: $PI"
  follower_ready=0
  for _ in $(seq 1 90); do
    if ssh "${SSH_OPTS[@]}" -o ConnectTimeout=2 "$SSH_TARGET" true >/dev/null 2>&1; then
      follower_ready=1
      break
    fi
    sleep 2
  done
  [ "$follower_ready" = 1 ] || die "follower did not return on configured network: $PI"
else
  pssh true || die "cannot SSH to $PI"
fi
if [ "$DRY_RUN" = 1 ]; then
  echo "dry run: skipping sudo bootstrap"
elif pssh 'sudo -n true' >/dev/null 2>&1; then
  echo "passwordless sudo available"
else
  password="${UMI_SUDO_PASSWORD:-}"
  if [ -z "$password" ] && [ -t 0 ]; then
    read -r -s -p "sudo password for $PI: " password
    echo
  fi
  [ -n "$password" ] || die "$PI needs sudo; run interactively or configure passwordless sudo"
  printf '%s\n' "$password" | pssh \
    "sudo -S -p '' sh -c 'printf \"%s ALL=(ALL) NOPASSWD:ALL\\n\" \"$PI_USER\" > /etc/sudoers.d/90-umi-provision && chmod 440 /etc/sudoers.d/90-umi-provision && visudo -cf /etc/sudoers.d/90-umi-provision'" \
    || die "sudo bootstrap failed for $PI"
  unset password
  SUDO_TEMP=1
fi
if [ "$DRY_RUN" = 0 ] && [ "$ROLE" = follower ] \
  && [ "$LEADER_HOTSPOT_ENABLED" = false ]; then
  pssh 'sudo -n systemctl disable --now umi-pair-wifi@follower.service >/dev/null 2>&1 || true'
  echo "follower locked to configured network for provisioning"
fi

log "2/7 render fixed $ROLE configuration"
CAMERA_DEVICE="$(pssh 'ls /dev/v4l/by-path/*usb-*-video-index0 2>/dev/null | head -1' || true)"
[ -n "$CAMERA_DEVICE" ] || die "no USB camera found on $PI"
if [ "$LEADER_HOTSPOT_ENABLED" = true ] && [ "$ROLE" = leader ]; then
  USB_WIFI_IFACES="$(pssh '
    for path in /sys/class/net/*/wireless; do
      [ -e "$path" ] || continue
      iface="${path%/wireless}"
      iface="${iface##*/}"
      [ "$iface" = umi-pair0 ] && continue
      if udevadm info --query=property --path="/sys/class/net/$iface" 2>/dev/null \
        | grep -qx "ID_BUS=usb"; then
        printf "%s\n" "$iface"
      fi
    done
  ' || true)"
  case "$USB_WIFI_IFACES" in
    "") die "leader needs exactly one USB Wi-Fi adapter; found none" ;;
    *$'\n'*) die "leader needs exactly one USB Wi-Fi adapter; found: $USB_WIFI_IFACES" ;;
    *) PAIR_WIFI_RADIO_IFACE="$USB_WIFI_IFACES" ;;
  esac
fi
if [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
  pssh "iw dev '$PAIR_WIFI_RADIO_IFACE' info >/dev/null" \
    || die "$ROLE pair Wi-Fi radio $PAIR_WIFI_RADIO_IFACE not found on $PI"
fi
json_string() { "$PYTHON" -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }
TASK_YAML="$(json_string "$TASK")"
CAMERA_YAML="$(json_string "$CAMERA_DEVICE")"
CALIB_YAML="$(json_string "$CAMERA_CALIB")"
cat > "$CFG_TMP" <<YAML
version: 1
task: $TASK_YAML
$ALIGNMENT_YAML
controls:
  buttons: { record: 12, quit: 16 }
  display: { kind: $DISPLAY_KIND, dc: 25, rst: 27, bl: 18 }
umis:
  $UMI_NAME:
    camera:
      device: $CAMERA_YAML
      width: 800
      height: 600
      fps: 30
      exposure: 100
      calib: $CALIB_YAML
    lidar:
      iface: eth0
      host_ip: 192.168.1.102
      lidar_ip: 192.168.1.200
    gripper:
      tag_ids: [$TAGS]
      stride: 2
$GRIPPER_CALIB_YAML
YAML
PYTHONPATH="$ROOT/common/umi-flow-core/src" "$PYTHON" -c \
  'import sys; from umi_flow_core.config import client_role,load_rig_config; actual=client_role(load_rig_config(sys.argv[1])); assert actual == sys.argv[2], (actual, sys.argv[2])' \
  "$CFG_TMP" "$ROLE"

COORD_ENV=""
if [ "$ROLE" = leader ]; then
  if [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
    COORD_ENV="UMI_FLOW_PEER=$PAIR_WIFI_FOLLOWER_IP:9140"
  else
    COORD_ENV="UMI_FLOW_PEER=${FOLLOWER#*@}:9140"
  fi
fi
cat > "$ENV_TMP" <<ENV
# Rendered by bin/provision-pi. Re-run bin/provision-pair to change it.
UMI_FLOW_CONFIG=config/umi.yaml
UMI_FLOW_SPOOL_DIR=$SPOOL_DIR
$COORD_ENV
ENV
cat > "$PAIR_WIFI_TMP" <<ENV
# Rendered by bin/provision-pi. Contains the private pair-network credential.
UMI_LEADER_HOTSPOT_ENABLED=$LEADER_HOTSPOT_ENABLED
UMI_PAIR_ROLE=$ROLE
UMI_PAIR_RADIO_IFACE=$PAIR_WIFI_RADIO_IFACE
UMI_PAIR_UPLINK_IFACE=$PAIR_WIFI_UPLINK_IFACE
UMI_PAIR_IFACE=$PAIR_WIFI_IFACE
UMI_PAIR_SSID=$PAIR_WIFI_SSID
UMI_PAIR_PSK=$PAIR_WIFI_PASSWORD
UMI_PAIR_CHANNEL=$PAIR_WIFI_CHANNEL
UMI_PAIR_COUNTRY=$PAIR_WIFI_COUNTRY
UMI_PAIR_LEADER_IP=$PAIR_WIFI_LEADER_IP
UMI_PAIR_FOLLOWER_IP=$PAIR_WIFI_FOLLOWER_IP
UMI_PAIR_SUBNET=$PAIR_WIFI_SUBNET
ENV
if [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
  PAIR_WIFI_REPORT="$PAIR_WIFI_SSID/$PAIR_WIFI_CHANNEL radio=$PAIR_WIFI_RADIO_IFACE uplink=$PAIR_WIFI_UPLINK_IFACE"
else
  PAIR_WIFI_REPORT="disabled"
fi
echo "$ROLE=$PI camera=$CAMERA_DEVICE calib=$CAMERA_CALIB tags=[$TAGS] gripper=$GRIPPER_REPORT pair_wifi=$PAIR_WIFI_REPORT spool=$SPOOL_DIR"

if [ "$DRY_RUN" = 1 ]; then
  echo "dry run complete: configuration validated; no files changed"
  exit 0
fi

log "3/7 deploy repository and runtime configuration"
pssh "mkdir -p '$REMOTE_REPO/config' '$SPOOL_DIR'"
RSYNC_SSH="ssh ${SSH_OPTS[*]}"
if [ -n "$SSH_JUMP" ]; then
  RSYNC_SSH="$RSYNC_SSH -J $SSH_JUMP"
fi
rsync -a --delete \
  --exclude-from "$ROOT/config/rsync-excludes" \
  --exclude '.git' --exclude '.venv' --exclude 'target' --exclude '__pycache__' \
  --exclude 'data' --exclude 'provisioning' --exclude '.env' --exclude 'config/umi.yaml' \
  --exclude '.pair-wifi.env' \
  --exclude 'demo-output' --exclude 'bin/render-demo' \
  --exclude 'tools/render_slam_demo.py' --exclude 'server/tests/test_slam_demo.py' \
  --exclude 'docker-compose.override.yml' \
  -e "$RSYNC_SSH" "$ROOT/" "$SSH_TARGET:$REMOTE_REPO/"
pcopy "$CFG_TMP" "$REMOTE_REPO/config/umi.yaml"
pcopy "$ENV_TMP" "$REMOTE_REPO/.env"
pcopy "$PAIR_WIFI_TMP" "$REMOTE_REPO/.pair-wifi.env"
pssh "chmod 600 '$REMOTE_REPO/.pair-wifi.env'"

log "4/7 install recorder"
pssh "cd '$REMOTE_REPO' && DEBIAN_FRONTEND=noninteractive PATH=\$HOME/.cargo/bin:\$HOME/.local/bin:\$PATH device/scripts/install_pi.sh" \
  || die "install_pi.sh failed on $PI"

log "5/7 authorize and install the SSH upload tunnel"
pssh 'test -f ~/.ssh/id_ed25519 || ssh-keygen -t ed25519 -N "" -f ~/.ssh/id_ed25519 >/dev/null'
PI_KEY="$(pssh 'cat ~/.ssh/id_ed25519.pub')"
printf '%s\n' "$PI_KEY" | ssh "${SSH_OPTS[@]}" "$SERVER" \
  'umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; key=$(cat); grep -qF "$key" ~/.ssh/authorized_keys || printf "%s\n" "$key" >> ~/.ssh/authorized_keys' \
  || die "could not authorize $PI on $SERVER"
sed -e "s#@USER@#$PI_USER#g" -e "s#@SSH_TARGET@#$SERVER#g" \
    -e 's#@LOCAL_PORT@#8080#g' -e 's#@REMOTE_PORT@#8080#g' \
    "$ROOT/config/systemd/umi-upload-tunnel.service" \
  | pssh 'sudo tee /etc/systemd/system/umi-upload-tunnel.service >/dev/null'
pssh 'sudo systemctl daemon-reload && sudo systemctl enable umi-upload-tunnel >/dev/null'

if [ "$REBOOT" = 0 ]; then
  log "6/7 remove temporary sudo access"
  remove_temporary_sudo
  echo "provisioned $ROLE; reboot $PI before recording"
  exit 0
fi

log "6/7 reboot"
BOOT_ID_BEFORE="$(pssh 'cat /proc/sys/kernel/random/boot_id')"
[ -n "$BOOT_ID_BEFORE" ] || die "could not read boot ID from $PI"
pssh 'sudo -n true' >/dev/null 2>&1 || die "lost sudo access before rebooting $PI"
pssh 'sudo -n systemctl reboot' >/dev/null 2>&1 || true
if [ "$ROLE" = follower ] && [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
  use_private_follower_transport
fi
echo "waiting for $PI to reboot..."
sleep 5
rebooted=0
for _ in $(seq 1 36); do
  BOOT_ID_AFTER="$(pssh 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null || true)"
  if [ -n "$BOOT_ID_AFTER" ] && [ "$BOOT_ID_AFTER" != "$BOOT_ID_BEFORE" ]; then
    rebooted=1
    break
  fi
  sleep 5
done
[ "$rebooted" = 1 ] || die "$PI did not complete a verified reboot"

log "7/7 remove temporary sudo access and verify"
remove_temporary_sudo
services_ready=0
for _ in $(seq 1 20); do
  WIFI_READY="true"
  if [ "$LEADER_HOTSPOT_ENABLED" = true ]; then
    WIFI_READY="systemctl is-active --quiet umi-pair-wifi@$ROLE"
  fi
  if pssh "$WIFI_READY && systemctl is-active --quiet umi-recorder && systemctl is-active --quiet umi-upload-tunnel && test -d '$SPOOL_DIR'"; then
    services_ready=1
    break
  fi
  sleep 2
done
[ "$services_ready" = 1 ] || die "$ROLE services failed verification on $PI"
echo "$ROLE client ready: $PI"
