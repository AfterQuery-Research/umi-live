# Machine-rendered runtime configuration. It is not user-edited.
.env
# Host-specific CPU/GPU compose override written by install_server.sh — must not
# be committed (a CPU host's copy would silently downgrade a GPU box to CPU SLAM).
docker-compose.override.yml
# The single user-edited deployment inventory.
provisioning/pair.env
# Ignore inventories created by versions before the dual-only setup.
provisioning/secrets
provisioning/server.env
provisioning/rigs/*.env
