/*
 * docker/slam-glim/config/config_ros.json — GLIM ROS-side override for the
 * umi-slam container. Copied over the stock file in /glim_config at image
 * build (see docker/slam-glim/Dockerfile).
 *
 * FULL-FILE replacement of the stock config_ros.json (fetched from
 * koide3/glim master and diffed 2026-07-15 — GLIM's nlohmann parser accepts
 * these comments; the stock files are commented too). Non-stock values are
 * marked OVERRIDE below; everything else is stock so behavior stays
 * image-default. Missing keys would fall back to GLIM code defaults anyway,
 * so a slightly older GLIM in the base image is fine.
 */
{
  "glim_ros": {
    // Backend modules (stock: local+global mapping on)
    "enable_local_mapping": true,
    "enable_global_mapping": true,
    // Points config
    "keep_raw_points": false,
    // IMU config
    "imu_time_offset": 0.0,
    "points_time_offset": 0.0,
    // Stock 0.0 = auto. rs_driver decodes Airy accel in g, but umi-decode
    // patches the ROS publish sites to SI (docker/decode/Dockerfile fix 4),
    // so bags carry spec-compliant m/s^2 — do NOT re-scale here. (History:
    // this was 9.80665 before the decode fix; the two together double-apply
    // gravity and GLIM flies away at ~9g even at rest.)
    "acc_scale": 1.0,
    // TF config (stock; frame ids auto-detected from the bag topics)
    "imu_frame_id": "",
    "lidar_frame_id": "",
    "base_frame_id": "",
    "odom_frame_id": "odom",
    "map_frame_id": "map",
    "publish_imu2lidar": true,
    "tf_time_offset": 1e-6,
    // OVERRIDE (stock adds libstandard_viewer.so + librviz_viewer.so):
    // headless batch container — no display, no RViz. Keep only the
    // memory monitor.
    "extension_modules": [
      "libmemory_monitor.so"
    ],
    // OVERRIDE (stock: ouster topics): the umi-decode stage's rosbag topics.
    "imu_topic": "/rslidar_imu_data",
    "points_topic": "/rslidar_points",
    "image_topic": "/image", // unused (no vision extension modules)
    // QoS options (stock; glim_rosbag feeds the bag directly anyway)
    "imu_qos": {
      "profile": "sensor_data",
      "depth": 1000
    },
    "points_qos": {
      "profile": "sensor_data"
    },
    "image_qos": {
      "profile": "sensor_data"
    }
  }
}
