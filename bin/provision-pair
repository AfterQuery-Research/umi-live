#!/usr/bin/env bash
# Provision the fixed two-client leader/follower rig from provisioning/pair.env.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PAIR_CONFIG="${PAIR_CONFIG:-$ROOT/provisioning/pair.env}"
[ -f "$PAIR_CONFIG" ] || {
  echo "provision-pair: missing $PAIR_CONFIG (copy provisioning/pair.env.example)" >&2
  exit 1
}
# shellcheck disable=SC1090
. "$PAIR_CONFIG"

EXTRA_ARGS=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run|--no-reboot) EXTRA_ARGS="$EXTRA_ARGS $1"; shift ;;
    -h|--help) echo "usage: bin/provision-pair [--dry-run] [--no-reboot]"; exit 0 ;;
    *) echo "provision-pair: unknown argument '$1'" >&2; exit 1 ;;
  esac
done

echo "=== follower: ${FOLLOWER:-<unset>} (right / umi2) ==="
# EXTRA_ARGS contains only the two fixed flag literals accepted above.
# shellcheck disable=SC2086
PAIR_CONFIG="$PAIR_CONFIG" "$ROOT/bin/provision-pi" --role follower $EXTRA_ARGS

echo
echo "=== leader: ${LEADER:-<unset>} (left / umi1) ==="
# shellcheck disable=SC2086
PAIR_CONFIG="$PAIR_CONFIG" "$ROOT/bin/provision-pi" --role leader $EXTRA_ARGS

echo
echo "pair ready; the leader record button controls both clients"
