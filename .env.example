# robot-umi configuration — REFERENCE. In the normal flow you never copy this by hand:
# every machine's .env is RENDERED from the workstation inventory (provisioning/secrets
# + provisioning/server.env + provisioning/rigs/<pi>.env):
#   * PROCESSING BOX: `./provision_server.sh <user@box>` renders + pushes the box .env
#     and runs server/scripts/install_server.sh. Mac host: `./provision_server.sh
#     --local` renders ./.env for mac/run_processing.sh. The HF token is fanned out
#     ONLY to the processing host — never to a Pi.
#   * RECORDER PI: `./provision_pi.sh <user@pi>` generates the Pi's .env (server URL +
#     shared token + spool + config) and pushes it.
# Hand-edit a .env only for a manual/dev setup — and know that a token edited out of
# sync with the inventory fails as a SILENT upload 401 loop. The fields below document
# every knob.
#
# `.env` is gitignored. install scripts source it; Docker Compose auto-loads it; the
# systemd units read it via EnvironmentFile.

# ===== shared: upload auth =======================================================
# The device sends this as X-Upload-Token; the ingest server requires it to match.
# Generate once and set the SAME value on both machines:  openssl rand -hex 32
ROBOT_UMI_UPLOAD_TOKEN=

# ===== device (Raspberry Pi) =====================================================
# Where the recorder posts episodes. For a cloud box whose only open port is 22,
# tunnel it (ssh -L 8080:localhost:8080 user@box) and point here at localhost.
ROBOT_UMI_SERVER_URL=http://SERVER_HOST:8080/upload
# Rig config the recorder loads (install_pi.sh seeds config/umi.yaml from an example).
ROBOT_UMI_CONFIG=config/umi.yaml
# Episode spool. Point this at the mounted SSD so captures don't fill the SD card.
ROBOT_UMI_SPOOL_DIR=/media/aq/SSD/umi_spool

# ===== processing box (GPU box OR Mac) — NOT the Pi =============================
# Host dir bind-mounted into every container as /data (episodes, derived, dataset).
DATA_DIR=./data
# Hugging Face dataset repo the dataset stage appends to (e.g. yourname/umi-dataset).
ROBOT_UMI_REPO_ID=
# HF auth for the push (a write token). Leave blank to keep datasets local-only.
# This is the one secret that must never reach a recorder Pi.
HF_TOKEN=
# Push to the Hub after each episode (1 = yes). Default off = local dataset only.
ROBOT_UMI_PUSH_TO_HUB=0
# Make the pushed HF repo public (1 = public). Default = private.
ROBOT_UMI_PUBLIC=0
# LeRobot dataset root. ROBOT_UMI_ENGINE is the trajectory subdir the dataset reads;
# leave it 'glim' for BOTH the GPU (install_server.sh) and Mac (run_processing.sh
# --engine mac) pipelines — the Mac SLAM stage is also named glim.
ROBOT_UMI_DATASET_ROOT=data/lerobot
ROBOT_UMI_ENGINE=glim
# Extra flags for the systemd runner (umi-runner.service). Bimanual two-Pi rigs MUST
# set --pair here (and `systemctl restart umi-runner`) or leader/follower uploads are
# never merged into 12-D episodes. The Mac pipeline's equivalent is PAIR=1.
#ROBOT_UMI_RUNNER_ARGS=--pair
# Compose runs umi-ingest as this host uid:gid so uploaded episodes are owned by you,
# not root (else the runner can't relocate paired sources and re-merges forever).
# install_server.sh fills these in automatically; set by hand only if your login uid
# isn't 1000 and you skipped the installer.
#HOST_UID=1000
#HOST_GID=1000
# ===== device (Pi) — bimanual pair; normally GENERATED by provision_pi.sh ========
# Solo rigs: leave all four unset. Pair rigs get these from provisioning/rigs/<pi>.env
# (ROLE/PEER_HOST/CONTROL_PORT/TIME_REF); listed here only for manual/dev setups.
# Leader→follower control is TCP 9140 — it must not be firewalled between the Pis.
#ROBOT_UMI_ROLE=leader|follower
#ROBOT_UMI_PEER=<follower-ip>:9140
#ROBOT_UMI_LISTEN_PORT=9140
#ROBOT_UMI_TIME_REF=<shared-ntp-host>
# Dev only: allow spooling to the SD card when no SSD is present.
# (provisioning spelling: ALLOW_SD_SPOOL=1 in the rig env)
#ROBOT_UMI_ALLOW_SD_SPOOL=1
