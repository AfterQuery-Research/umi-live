# Tie the NIC's hardware clock (PHC) to the system clock so the PTP time ptp4l
# serves equals CLOCK_REALTIME. Started conditionally: USB-GbE dongles usually
# have NO PHC (software timestamping) — the ExecCondition probe makes this unit
# a clean no-op there, and the manifest records timestamping_mode per interface.
#
#   sudo systemctl enable --now umi-phc2sys@eth0
[Unit]
Description=PHC<->system clock sync (phc2sys) for %i
After=umi-ptp@%i.service
BindsTo=umi-ptp@%i.service

[Service]
Type=simple
ExecCondition=/bin/sh -c "ethtool -T %i | grep -q 'PTP Hardware Clock: [0-9]'"
# -s CLOCK_REALTIME -c %i: system clock is the source, PHC follows (the Pi is master).
# Chrony may step CLOCK_REALTIME after phc2sys's first update during boot. Without
# a persistent step threshold, the PHC can remain days behind while phc2sys slews
# at its 64,000,000 ppb limit, leaving the Airy permanently UnLock. The PHC is an
# isolated LiDAR time source, so stepping it whenever it is over 1 ms out is safe.
ExecStart=/usr/sbin/phc2sys -s CLOCK_REALTIME -c %i -O 0 -u 8 -S 0.001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
