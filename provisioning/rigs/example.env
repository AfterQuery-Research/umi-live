# provisioning/rigs/<name>.env — LOCAL, gitignored (cp example.env -> <pi-host>.env).
# One record per rig. bin/provision-pi sources this after the secrets file. Defaults suit
# a single RoboSense Airy + one USB camera; override per rig. Values are shell-quoted.

# --- processing target: where episodes upload (override with --target on the CLI) ---
#   mac -> a Mac running mac/run_processing.sh, reached via a boot-persistent Pi-side
#          SSH tunnel to MAC_HOST (Pi localhost:8091 -> Mac ingest; arm64 GLIM, no GPU).
#   gpu -> a GPU box's ingest (compose decode + CUDA GLIM). Directly at SERVER_URL on a
#          LAN box, OR — for a cloud box whose only open port is 22 — set SERVER_SSH and
#          it tunnels Pi localhost:8080 -> box:8080 (same mechanism as the mac target).
#   url -> any other ingest, directly at SERVER_URL.
RIG_TARGET="mac"
MAC_HOST=""                 # user@mac-host   (target=mac only; Mac must run sshd)
SERVER_URL=""               # http://host:8080/upload   (target=gpu direct-LAN box, or url)
SERVER_SSH=""               # user@box  (target=gpu, SSH-only cloud box — tunnels Pi 8080->box 8080)

# --- SSD spool (an already-formatted disk, NOT the SD card) ------------------
SSD_MOUNTPOINT="/media/aq/SSD"
SPOOL_DIR="/media/aq/SSD/umi_spool"
# SSD_DEVICE="/dev/sda1"    # optional: force the partition if auto-detect is ambiguous
# ALLOW_SD_SPOOL="1"       # dev only: no SSD, spool to the SD card (slow, small)

# --- rig config (rendered into config/umi.yaml on the Pi) --------------------
# To use a full hand-written config instead, set RIG_CONFIG_FILE (repo-relative) and
# everything below is ignored:
# RIG_CONFIG_FILE="config/umi.yaml"
UMI_NAME="umi1"
MOTION_SOURCE="lidar"
TASK="umi demo task"
# CAMERA_DEVICE=""          # blank -> auto-discover the camera by-path node on the Pi
CAMERA_WIDTH="800"; CAMERA_HEIGHT="600"; CAMERA_FPS="30"; CAMERA_EXPOSURE="100"
CAMERA_CALIB="config/calib/umi1_calib.npz"
LIDAR_TYPE="auto"; LIDAR_IFACE="eth0"
LIDAR_HOST_IP="192.168.1.102"; LIDAR_IP="192.168.1.200"
GRIPPER_TAGS="0, 1"

# --- controls (BCM GPIO pins; all must be distinct — validated at config load) -
BTN_RECORD="12"; BTN_QUIT="16"; BTN_MODE="22"
LCD_KIND="lcd"              # lcd | none  (none = this rig has no status LCD)
LCD_DC="25"; LCD_RST="27"; LCD_BL="18"

# --- two-Pi bimanual pair (leave ROLE="solo" for a normal single-Pi rig) ------
# For a coordinated pair, give each Pi its own <host>.env; a hand-written pair config
# via RIG_CONFIG_FILE keeps the two arms' UMI names/tags disjoint:
#   Leader:   ROLE="leader"    RIG_CONFIG_FILE="config/umi.pair-leader.example.yaml"
#             PEER_HOST="<follower-ip>"   TIME_REF="<shared-ntp-ip>"
#   Follower: ROLE="follower"  RIG_CONFIG_FILE="config/umi.pair-follower.example.yaml"
#             TIME_REF="<shared-ntp-ip>"
# Then run:  ./bin/provision-pair <leader user@host> <follower user@host>
ROLE="solo"                 # solo | leader | follower
PEER_HOST=""                # leader only: the follower Pi's IP (control channel)
CONTROL_PORT="9140"         # leader<->follower control socket port
TIME_REF=""                 # shared NTP server both Pis discipline to (chrony); "" = off
